{
	"name": "@lowrouter/n8n-nodes-lowrouter",
	"version": "0.1.1",
	"description": "LowRouter chat model for n8n: carbon-aware LLM routing with EU and sovereignty scopes",
	"license": "MIT",
	"homepage": "https://github.com/carboniferio/n8n-nodes-lowrouter#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"lowrouter",
		"llm",
		"ai",
		"chat-model",
		"openai-compatible"
	],
	"author": {
		"name": "Olivier Bierlaire",
		"email": "obierlaire@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/carboniferio/n8n-nodes-lowrouter.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test test/*.test.js",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"aiNodeSdkVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/LowRouterApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/LmChatLowRouter/LmChatLowRouter.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*",
		"@n8n/ai-node-sdk": "*"
	},
	"bugs": {
		"url": "https://github.com/carboniferio/n8n-nodes-lowrouter/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}
